# ---------------------------------------------------------------------------
# JalNetra backend settings. Copy to .env and adjust. Every key read by
# backend/app/core/config.py is listed here with its default.
# Inside Docker Compose the service hostnames (postgres, redis, minio) are
# injected by docker-compose.yml and override the localhost defaults below.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=JalNetra
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL 16 + PostGIS + TimescaleDB ---
POSTGRES_USER=jalnetra
POSTGRES_PASSWORD=jalnetra
POSTGRES_DB=jalnetra
DATABASE_URL=postgresql+asyncpg://jalnetra:jalnetra@localhost:5432/jalnetra

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (S3-compatible object store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=jalnetra
MINIO_ROOT_PASSWORD=jalnetra123
MINIO_ACCESS_KEY=jalnetra
MINIO_SECRET_KEY=jalnetra123
MINIO_BUCKET=jalnetra
MINIO_SECURE=false

# --- TiTiler (raster tile server) ---
TITILER_URL=http://localhost:8001

# --- Health check ---
HEALTH_CHECK_TIMEOUT_S=3.0

# --- Local data cache (MGRS grid KML, seed files) ---
DATA_DIR=data
S2_GRID_KML_URL=https://sentinels.copernicus.eu/documents/247904/1955685/S2A_OPER_GIP_TILPAR_MPC__20151209T095117_V20150622T000000_21000101T000000_B00.kml

# --- Satellite ingestion (L3) ---
STAC_SOURCE=earth-search           # earth-search (no auth, default) | cdse
STAC_FALLBACK=true
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
STAC_MAX_CLOUD_PCT=60
INGEST_LOOKBACK_DAYS=7
INGEST_CACHE_PREFIX=cache
# GDAL: windowed reads only issue range requests for the .tif we asked for
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif

# --- Alerts + delivery (S8) ---
# Master switch. Off by default so a dev box never pages a regional office.
DISPATCH_ENABLED=false
PUBLIC_BASE_URL=http://localhost:8000
# SMTP for e-mail recipients (leave unset to disable the e-mail channel)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=jalnetra@example.org
