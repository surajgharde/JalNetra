# ---------------------------------------------------------------------------
# JalNetra backend settings. Copy to .env and adjust. Every key read by
# backend/app/core/config.py is listed here with its default.
# Inside Docker Compose the service hostnames (postgres, redis, minio) are
# injected by docker-compose.yml and override the localhost defaults below.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=JalNetra
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL 16 + PostGIS + TimescaleDB ---
POSTGRES_USER=jalnetra
POSTGRES_PASSWORD=jalnetra
POSTGRES_DB=jalnetra
DATABASE_URL=postgresql+asyncpg://jalnetra:jalnetra@localhost:5432/jalnetra

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (S3-compatible object store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=jalnetra
MINIO_ROOT_PASSWORD=jalnetra123
MINIO_ACCESS_KEY=jalnetra
MINIO_SECRET_KEY=jalnetra123
MINIO_BUCKET=jalnetra
MINIO_SECURE=false

# --- TiTiler (raster tile server) ---
TITILER_URL=http://localhost:8001

# --- Health check ---
HEALTH_CHECK_TIMEOUT_S=3.0

# --- Local data cache (MGRS grid KML, seed files) ---
DATA_DIR=data
S2_GRID_KML_URL=https://sentinels.copernicus.eu/documents/247904/1955685/S2A_OPER_GIP_TILPAR_MPC__20151209T095117_V20150622T000000_21000101T000000_BSTAC_SOURCE=earth-search           # earth-search (no auth, default) | cdse | gee (needs GEE_ENABLED)
STAC_FALLBACK=true
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
STAC_MAX_CLOUD_PCT=60
INGEST_LOOKBACK_DAYS=7
INGEST_CACHE_PREFIX=cache

# --- Google Earth Engine (optional: third ingestion source + live imagery on the map) ---
# Earth Engine has no API keys. Create a Google Cloud project, enable the
# "Google Earth Engine API", register the project at https://code.earthengine.google.com/register
# (non-commercial / research is free), create a service account with the
# "Earth Engine Resource Viewer" role and download its JSON key. Put the key at
# backend/data/secrets/gee-service-account.json (git-ignored; visible inside Docker
# at /app/data/secrets/...) or paste it into GEE_SERVICE_ACCOUNT_KEY_JSON.
GEE_ENABLED=false
GEE_PROJECT=                                   # e.g. jalnetra-123456
# Dev alternative to a key: `cd backend && uv run earthengine authenticate` (Google sign-in);
# docker-compose mounts the resulting ~/.config/earthengine into the containers.
# EARTHENGINE_CREDENTIALS_DIR=~/.config/earthengine
GEE_SERVICE_ACCOUNT_KEY=data/secrets/gee-service-account.json
# GEE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account",...}'
GEE_COLLECTION=COPERNICUS/S2_SR_HARMONIZED
GEE_HIGH_VOLUME=true
GEE_MAP_TTL_S=3600
=60
INGEST_LOOKBACK_DAYS=7
INGEST_CACHE_PREFIX=cache
# GDAL: windowed reads only issue range requests for the .tif we asked for
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif

# --- Alerts + delivery (S8) ---
# Master switch. Off by default so a dev box never pages a regional office.
DISPATCH_ENABLED=false
PUBLIC_BASE_URL=http://localhost:8000
# SMTP for e-mail recipients (leave unset to disable the e-mail channel)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=jalnetra@example.org

# --- Pipeline-run report export ---
REPORT_SATELLITE_SOURCE=auto      # auto | gee | cache : per-day satellite image in the PDF
REPORT_MAX_DAY_PAGES=60

# --- Ops (S12) ---
# SENTRY_DSN=https://...@sentry.io/...        # needs `uv sync --extra ops`
WORKER_METRICS_PORT=9100
WORKERS_INGESTION=2
WORKERS_PROCESSING=2
WORKERS_SCORING=1
WORKERS_REPORTING=1
GRAFANA_USER=admin
GRAFANA_PASSWORD=jalnetra
