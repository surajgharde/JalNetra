# ---------------------------------------------------------------------------
# JalNetra backend settings. Copy to .env and adjust. Every key read by
# backend/app/core/config.py is listed here with its default.
# Inside Docker Compose the service hostnames (postgres, redis, minio) are
# injected by docker-compose.yml and override the localhost defaults below.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=JalNetra
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL 16 + PostGIS + TimescaleDB ---
POSTGRES_USER=jalnetra
POSTGRES_PASSWORD=jalnetra
POSTGRES_DB=jalnetra
DATABASE_URL=postgresql+asyncpg://jalnetra:jalnetra@localhost:5432/jalnetra

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (S3-compatible object store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=jalnetra
MINIO_ROOT_PASSWORD=jalnetra123
MINIO_ACCESS_KEY=jalnetra
MINIO_SECRET_KEY=jalnetra123
MINIO_BUCKET=jalnetra
MINIO_SECURE=false

# --- TiTiler (raster tile server) ---
TITILER_URL=http://localhost:8001

# --- Health check ---
HEALTH_CHECK_TIMEOUT_S=3.0
